{
 "db_name": "SiteBuilder",
 "db_file": "data/sitebuilder.db",
 "version": 1,
 "maps": {
  "settings.json": {
   "to_keyvalue": ["title", "description", "theme"]
  },
  "pages/.+\\.json": {
   "to_table": ["page"]
  }
 },
 "tables": {
  "page": {
   "cols": [
    ["page_id", "INTEGER"],
    ["slug", "TEXT"],
    ["title", "TEXT"],
    ["modified", "INTEGER"],
    ["json_id", "INTEGER REFERENCES json (json_id)"]
   ],
   "indexes": [
    "CREATE UNIQUE INDEX page_key ON page(json_id, page_id)",
    "CREATE INDEX page_slug ON page(slug)"
   ],
   "schema_changed": 1
  }
 }
}
