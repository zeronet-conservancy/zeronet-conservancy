# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Log files
**/*.log

# Hidden files
.*
!.dockerignore
!/.github
!/.gitignore
!/.travis.yml
!/.gitlab-ci.yml

# Temporary files
*.bak
*~

# Data dir
data/*
docker/data/
*.db

# Virtualenv
env/*
venv/*

# Tor data
tools/tor/data

# PhantomJS, downloaded manually for unit tests
tools/phantomjs

# ZeroNet config file
zeronet.conf

# ZeroNet log files
log/*

